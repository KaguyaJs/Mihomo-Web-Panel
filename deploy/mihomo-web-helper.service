[Unit]
Description=Mihomo Web Panel UID-checked fixed-unit systemd helper
Requires=mihomo-web-helper.socket
After=mihomo-web-helper.socket

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/mihomo-web/helper.env
ExecStart=/usr/local/libexec/mihomo-web-helper --allowed-uid ${MIHOMO_WEB_UID}
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
