[Unit]
Description=Mihomo Web Panel - independent secure management console
Documentation=https://github.com/KaguyaJs/mihomo-web-panel
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=mihomo-web
Group=mihomo-web
WorkingDirectory=/var/lib/mihomo-web
ExecStart=/usr/local/bin/mihomo-web-panel --config /etc/mihomo-web/config.toml serve
Environment=RUST_LOG=mihomo_web_panel=info
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077
StateDirectory=mihomo-web
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/mihomo-web
ReadOnlyPaths=/etc/mihomo-web

[Install]
WantedBy=multi-user.target
